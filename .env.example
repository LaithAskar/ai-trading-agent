ANTHROPIC_API_KEY=

AGENT_MODEL=claude-sonnet-4-6
AGENT_MAX_ITERS=20
AGENT_MAX_TOKENS_PER_CALL=4096

# Hard kill the loop if the session exceeds these. The dollar cap is computed
# against an approximate pricing table; verify against Anthropic's current prices.
AGENT_MAX_SESSION_TOKENS=200000
AGENT_MAX_SESSION_DOLLARS=1.00

ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Public's official API is live-account infrastructure; this repository keeps
# order submission disabled until a separately reviewed live contract exists.
PUBLIC_API_SECRET_KEY=
PUBLIC_ACCOUNT_NUMBER=

LIVE_TRADING=false

LOG_LEVEL=INFO

# SEC EDGAR requires a User-Agent identifying the requester (their fair-use policy).
# Format: "Name email@example.com"
SEC_USER_AGENT=trading-agent research you@example.com

# Free key at https://www.alphavantage.co/support/#api-key (no card required).
# Used by the news_sentiment strategy and the get_news_sentiment agent tool.
ALPHAVANTAGE_API_KEY=

# OpenRouter sign-in (V8c). The web app's primary login is OAuth — users authorize
# on openrouter.ai instead of pasting a key, and the agent runs via OpenRouter's
# native Anthropic Messages endpoint. These are only needed for local/self-hosting:
#   OPENROUTER_API_KEY: skip the OAuth click locally by supplying a key directly.
#   OPENROUTER_CALLBACK_URL: where OpenRouter redirects back after authorizing.
#     OpenRouter only allows https:443 or http://localhost:3000, so to test the
#     OAuth flow locally run: streamlit run streamlit_app.py --server.port 3000
OPENROUTER_API_KEY=
OPENROUTER_CALLBACK_URL=http://localhost:3000
